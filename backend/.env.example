# Get these free at https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Get this free at https://jooble.org/api/about
JOOBLE_API_KEY=your_jooble_api_key

# Get this free at https://rapidapi.com/jsearchapi-jsearchapi-default/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key

# Comma-separated list of country codes for Adzuna to search - covers
# the whole world. Override with a single code (e.g. "in") for one country.
ADZUNA_COUNTRIES=au,br,ca,de,es,fr,gb,in,it,mx,nl,nz,pl,ru,sg,us,za

PORT=5000
